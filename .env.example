# Provider: openrouter (default) or ollama
WEBAI_LLM_PROVIDER=openrouter

# Hosted OpenAI-compatible provider settings (unchanged defaults)
WEBAI_LLM_BASE_URL=https://openrouter.ai/api/v1
WEBAI_LLM_MODEL=openrouter/free
WEBAI_LLM_API_KEY=

# Optional local Ollama settings. When WEBAI_LLM_PROVIDER=ollama,
# the Ollama-specific values take precedence over the hosted provider settings.
WEBAI_OLLAMA_BASE_URL=http://localhost:11434/v1
WEBAI_OLLAMA_MODEL=qwen3:4b

WEBAI_LLM_TIMEOUT=90
WEBAI_MAX_STEPS=12
WEBAI_HEADLESS=false
WEBAI_VISION_ENABLED=false
WEBAI_MEMORY_PATH=webai_memory.sqlite3
WEBAI_ARTIFACT_DIR=artifacts
